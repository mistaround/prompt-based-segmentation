# Upstream clones are pinned + fetched by each model's setup.sh, not vendored here.
*/repo/
# Model weights (hundreds of MB)
*/weights/
# uv environments & caches
.venv/
*/.venv/
__pycache__/
*.pyc
# Benchmark output: keep the result JSONs and the rendered demos (they are the
# evidence for docs/RESULTS.md), drop everything else.
*/outputs/*
!*/outputs/*.json
!*/outputs/demo_*.jpg
!*/outputs/everything_*.jpg
!*/outputs/text_*.jpg
# Benchmark dataset (fetched by scripts/get_dataset.sh)
datasets/
